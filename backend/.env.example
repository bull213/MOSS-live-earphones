# Copy this file to backend/.env and enter the key locally. Never commit the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
MOSS_API_KEY=
MOSS_MODEL=moss-live-1.0

# Select stepfun explicitly to use Step 5 Preview.
ASSISTANT_PROVIDER=openai
STEPFUN_API_KEY=
STEPFUN_REGION=global
# Optional HTTPS override; leave empty to use the endpoint for the region.
STEPFUN_BASE_URL=
STEPFUN_MODEL=step-5-preview
STEPFUN_REASONING_EFFORT=low
# Configure current regional prices before enabling knowledge-assisted requests.
STEPFUN_INPUT_USD_PER_MILLION=
STEPFUN_OUTPUT_USD_PER_MILLION=
AGENT_MAX_ESTIMATED_USD=0.10
